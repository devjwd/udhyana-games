{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "npx prisma generate --schema=./src/backend/schema.prisma && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "desktop:dev": "electron .",
    "package:exe": "electron-builder --win",
    "sync:offline": "node scripts/sync-offline-data.mjs",
    "build:desktop": "node scripts/sync-offline-data.mjs && electron-builder --win && node scripts/post-build-copy.mjs",
    "db:generate": "npx prisma generate --schema=./src/backend/schema.prisma",
    "db:push": "npx prisma db push --schema=./src/backend/schema.prisma",
    "db:inspect": "node scripts/inspect-db.mjs",
    "db:test": "node scripts/test-db.mjs",
    "admin:make": "node scripts/make-admin.mjs",
    "icons:generate": "node scripts/generate_icons.js"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.5",
    "dotenv": "^17.4.2",
    "lgtv2": "^2.1.0",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "wake_on_lan": "^1.0.0"
  },
  "devDependencies": {
    "@prisma/config": "^7.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "typescript": "^5"
  }
}
