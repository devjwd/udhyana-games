{
  "appId": "com.udhyanagames.reception",
  "productName": "Udhyana Games Reception",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "package.json",
    "reception-config.json",
    "!node_modules/**/*"
  ],
  "nodeGypRebuild": false,
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Udhyana Games Reception"
  }
}
